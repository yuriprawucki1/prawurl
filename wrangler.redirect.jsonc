{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "prawurl-redirect",
  "account_id": "d723634128052b662d1eb6b6fa16054f",
  "main": "src/workers/redirect/index.ts",
  "compatibility_date": "2026-04-25",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "routes": [
    {
      "pattern": "prawurl.com/*",
      "zone_name": "prawurl.com"
    }
  ],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application"
  },
  "vars": {
    "PUBLIC_ORIGIN": "https://prawurl.com"
  },
  "kv_namespaces": [
    {
      "binding": "PRAWURL_LINKS",
      "id": "7ed7b229a529421ca7c284f113588769"
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "prawurl",
      "database_id": "fbd6cd66-3f82-4072-9e18-fcdcd3be78d7",
      "migrations_dir": "migrations"
    }
  ],
  "queues": {
    "producers": [
      {
        "binding": "EVENTS",
        "queue": "prawurl-events"
      }
    ]
  },
  "env": {
    "staging": {
      "name": "prawurl-redirect-staging",
      "routes": [
        {
          "pattern": "staging.prawurl.com/*",
          "zone_name": "prawurl.com"
        }
      ],
      "vars": {
        "PUBLIC_ORIGIN": "https://staging.prawurl.com"
      },
      "kv_namespaces": [
        {
          "binding": "PRAWURL_LINKS",
          "id": "e2ab7ee7345046f6950b02bd07a2f130"
        }
      ],
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "prawurl-staging",
          "database_id": "98ee97e5-50d4-433b-97be-868df2291f20",
          "migrations_dir": "migrations"
        }
      ],
      "queues": {
        "producers": [
          {
            "binding": "EVENTS",
            "queue": "prawurl-events-staging"
          }
        ]
      }
    }
  }
}
